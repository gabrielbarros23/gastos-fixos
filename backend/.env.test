# Usado pelos testes e2e (npm run test:e2e). Só contém valores locais, sem segredos reais.
NODE_ENV=test
PORT=3001
DATABASE_URL="postgresql://gastos:gastos@localhost:5433/gastos_test?schema=public"
JWT_ACCESS_SECRET="segredo-de-teste-com-pelo-menos-32-caracteres"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Custo mínimo do bcrypt: deixa os testes rápidos (em produção o padrão é 12)
BCRYPT_SALT_ROUNDS=4
CORS_ORIGIN="http://localhost:5173"
