# Usado pelos testes e2e (npm run test:e2e). Só contém valores locais, sem segredos reais.
NODE_ENV=test
PORT=3001
DATABASE_URL="postgresql://gastos:gastos@localhost:5433/gastos_test?schema=public"
JWT_ACCESS_SECRET="segredo-de-teste-com-pelo-menos-32-caracteres"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Custo mínimo do bcrypt: deixa os testes rápidos (em produção o padrão é 12)
BCRYPT_SALT_ROUNDS=4
CORS_ORIGIN="http://localhost:5173"
APP_TIMEZONE="America/Sao_Paulo"
APP_URL="http://localhost:5173"
# Filas dos testes num prefixo próprio, separadas das de desenvolvimento
QUEUE_PREFIX=gastos-test
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Gastos Fixos <lembretes@gastos.dev>"
# API do Mailpit: os testes e2e leem os e-mails enviados por aqui
MAILPIT_URL="http://localhost:8025"
