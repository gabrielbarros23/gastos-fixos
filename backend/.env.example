NODE_ENV=development
PORT=3000

# PostgreSQL do docker-compose (porta 5433 no host)
DATABASE_URL="postgresql://gastos:gastos@localhost:5433/gastos?schema=public"

# Autenticação
# Gere um segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12

# Origem do frontend liberada no CORS
CORS_ORIGIN="http://localhost:5173"

# Fuso usado para saber "que dia é hoje" nas regras de vencimento
APP_TIMEZONE="America/Sao_Paulo"

# URL do frontend (links nos e-mails)
APP_URL="http://localhost:5173"

# Filas (BullMQ) no Redis do docker-compose
REDIS_HOST=localhost
REDIS_PORT=6379
QUEUE_PREFIX=gastos
# Varredura diária de lembretes: todo dia às 8h (no fuso APP_TIMEZONE)
REMINDER_CRON="0 8 * * *"

# E-mail: em desenvolvimento, o Mailpit captura tudo (veja em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Gastos Fixos <lembretes@gastos.dev>"
