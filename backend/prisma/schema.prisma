generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Convenções:
// - Tabelas e colunas em snake_case no banco (@@map/@map), camelCase no código.
// - IDs UUIDv7: não dá para enumerar e, por serem ordenados no tempo, indexam melhor que o v4.
// - Instantes (createdAt etc.) em timestamptz; datas "de calendário" (vencimentos) usarão date.

model User {
  id                 String   @id @default(uuid(7)) @db.Uuid
  name               String
  email              String   @unique // sempre salvo em minúsculas
  passwordHash       String   @map("password_hash")
  remindersEnabled   Boolean  @default(true) @map("reminders_enabled")
  reminderDaysBefore Int      @default(1) @map("reminder_days_before")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens  RefreshToken[]
  categories     Category[]
  paymentMethods PaymentMethod[]
  expenses       Expense[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // SHA-256 do token. O token em si só existe no cookie do usuário.
  tokenHash String    @unique @map("token_hash")
  // Todos os tokens de uma mesma sessão (cadeia de rotação). Se um token já
  // usado reaparecer, a família inteira é revogada.
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum Frequency {
  WEEKLY // a cada `interval` semanas
  MONTHLY // a cada `interval` meses (3 = trimestral, 6 = semestral)
  YEARLY // a cada `interval` anos

  @@map("frequency")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  color     String // "#RRGGBB"
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, name])
  @@map("categories")
}

enum PaymentMethodType {
  CREDIT_CARD // entra na fatura: o mês é o do vencimento da fatura
  DEBIT_CARD
  PIX // inclui Pix automático
  BOLETO
  ACCOUNT_DEBIT // débito automático em conta
  OTHER

  @@map("payment_method_type")
}

// Por onde o dinheiro sai (cartão Nubank, Pix automático do C6...). Cadastrada
// pelo usuário. O resumo mostra quanto cada uma vai cobrar em cada mês.
model PaymentMethod {
  id         String            @id @default(uuid(7)) @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  name       String
  type       PaymentMethodType
  color      String // "#RRGGBB"
  // Só cartão de crédito (CHECK no banco): definem em qual fatura cada cobrança entra.
  closingDay Int?              @map("closing_day")
  dueDay     Int?              @map("due_day")
  // Só cartões (crédito ou débito), opcional: os 4 últimos dígitos, para o
  // usuário diferenciar cartões. Nunca o número inteiro.
  lastDigits String?           @map("last_digits")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments ExpensePaymentMethod[]

  @@unique([userId, name])
  @@map("payment_methods")
}

// Guarda a REGRA do gasto. As ocorrências (cada vencimento) são calculadas sob
// demanda a partir dela e nunca são gravadas antecipadamente.
model Expense {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  categoryId       String    @map("category_id") @db.Uuid
  name             String
  description      String?
  frequency        Frequency
  interval         Int       @default(1)
  // Datas "de calendário" (sem hora e sem fuso): coluna date.
  startDate        DateTime  @map("start_date") @db.Date // 1º vencimento; define o dia âncora
  endDate          DateTime? @map("end_date") @db.Date // último vencimento possível (inclusivo)
  installmentCount Int?      @map("installment_count") // se informado, endDate é calculada
  deactivatedAt    DateTime? @map("deactivated_at") @db.Date // null = ativo
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: o banco impede excluir uma categoria que ainda tem gastos.
  category  Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amounts        ExpenseAmount[]
  paymentMethods ExpensePaymentMethod[]
  payments       Payment[]
  reminders      ReminderLog[]

  @@index([userId])
  // O Postgres não indexa FKs sozinho; sem isso, cada exclusão de categoria
  // faria um scan em expenses para checar o Restrict.
  @@index([categoryId])
  @@map("expenses")
}

// Histórico de valor: mudar o preço é inserir uma linha nova com a data de
// vigência. O valor de um vencimento é o da maior vigência <= a data dele.
model ExpenseAmount {
  id            String   @id @default(uuid(7)) @db.Uuid
  expenseId     String   @map("expense_id") @db.Uuid
  amountCents   Int      @map("amount_cents") // centavos, nunca float
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, effectiveFrom])
  @@map("expense_amounts")
}

// Histórico da forma de pagamento, no mesmo padrão do histórico de valor: trocar
// a Netflix do Nubank para o PicPay em junho é inserir uma linha vigente desde
// junho, e os meses anteriores continuam no Nubank. Opcional: sem nenhuma linha
// vigente, o vencimento fica "sem forma de pagamento".
model ExpensePaymentMethod {
  id              String   @id @default(uuid(7)) @db.Uuid
  expenseId       String   @map("expense_id") @db.Uuid
  // null = deixa de ter forma de pagamento a partir de effectiveFrom
  paymentMethodId String?  @map("payment_method_id") @db.Uuid
  effectiveFrom   DateTime @map("effective_from") @db.Date
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  expense       Expense        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  // Restrict: não dá para excluir uma forma de pagamento que algum gasto usa ou usou.
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@unique([expenseId, effectiveFrom])
  @@index([paymentMethodId])
  @@map("expense_payment_methods")
}

// Uma ocorrência só é gravada quando algo acontece com ela: aqui, o pagamento.
// Ela é identificada pela chave natural (expense_id, due_date), a mesma que a
// regra de recorrência calcula, então não existe "id de ocorrência".
model Payment {
  id              String   @id @default(uuid(7)) @db.Uuid
  expenseId       String   @map("expense_id") @db.Uuid
  dueDate         DateTime @map("due_date") @db.Date // qual vencimento foi pago
  paidAmountCents Int      @map("paid_amount_cents") // pode diferir do previsto (juros, desconto)
  paidAt          DateTime @map("paid_at") @db.Date // quando o usuário pagou
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, dueDate])
  @@map("payments")
}

enum ReminderStatus {
  PENDING // reservado pelo worker, e-mail ainda não confirmado
  SENT

  @@map("reminder_status")
}

// Garantia de "no máximo um lembrete por vencimento" (idempotência). A fila
// também deduplica pelo jobId, mas o job some do Redis depois de concluído;
// esta tabela é o registro permanente.
model ReminderLog {
  id        String         @id @default(uuid(7)) @db.Uuid
  expenseId String         @map("expense_id") @db.Uuid
  dueDate   DateTime       @map("due_date") @db.Date
  status    ReminderStatus @default(PENDING)
  sentAt    DateTime?      @map("sent_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, dueDate])
  @@map("reminder_logs")
}
