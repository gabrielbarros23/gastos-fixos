      "preRequestScript": "",
      "afterResponseScript": "// Salva o id criado em expense_id, usado pelas próximas requisições.\nif (insomnia.response.code === 201) {\n  insomnia.baseEnvironment.set('expense_id', insomnia.response.json().id);\n}",
