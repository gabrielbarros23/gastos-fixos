      "url": "{{ _.base_url }}/auth/register",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Novo Usuário\",\n  \"email\": \"novo@gastos.dev\",\n  \"password\": \"senha-forte-123\"\n}"
