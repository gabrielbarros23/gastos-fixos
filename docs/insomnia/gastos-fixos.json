      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Netflix\",\n  \"description\": \"Plano padrão\",\n  \"categoryId\": \"{{ _.category_id }}\",\n  \"amountCents\": 5590,\n  \"frequency\": \"MONTHLY\",\n  \"interval\": 1,\n  \"startDate\": \"{{ _.start_date }}\",\n  \"paymentMethodId\": \"{{ _.payment_method_id }}\"\n}"
      },
      "parameters": [],
      "headers": [
